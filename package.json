{
  "name": "robolime",
  "version": "0.1.0",
  "private": true,
  "description": "RoboLime software: Expo mobile/web app, shared domain and protocol contracts, and the offline-first field gateway (no hardware integration yet).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @robolime/mobile",
    "web": "npm run web --workspace @robolime/mobile",
    "android": "npm run android --workspace @robolime/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build:web": "npm run build:web --workspace @robolime/mobile",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:cloud:test": "node supabase/tests/run-local-postgres.mjs",
    "db:cloud:types": "node supabase/tests/run-local-postgres.mjs --gen-types packages/shared/src/generated/database.types.ts",
    "demo:pairing": "npm run demo:pairing --workspace @robolime/gateway --",
    "demo:serve": "npm run demo:serve --workspace @robolime/gateway --",
    "cloud:claim-code": "npm run cloud:claim-code --workspace @robolime/gateway --"
  },
  "engines": {
    "node": "^22.16.0 || ^24.3.0 || >=26.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4"
  }
}
