# RoboLime app (mobile + web) environment template.
# Copy to apps/mobile/.env.local and fill in. Real .env files are git-ignored.
#
# EXPO_PUBLIC_* values are inlined into the client bundle and are visible to
# anyone with the app. NEVER put a Supabase service-role key or any other
# secret here. Gateway secrets will live in the gateway's own env file.

# Default laptop gateway base URL for field (offline) mode, e.g. http://<laptop-LAN-IP>:<port>
EXPO_PUBLIC_GATEWAY_URL=

# Hosted Supabase cloud mirror (online mode only; not used in Phase 1).
# Public anon key only — protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
