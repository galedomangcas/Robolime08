# RoboLime field gateway environment template (laptop / Raspberry Pi only).
# Copy to apps/gateway/.env.local and fill in. Real .env files are git-ignored.
# These values must NEVER be copied into the Expo app or any web bundle.

# --- Used now ----------------------------------------------------------------
# Path of the durable field SQLite database, e.g. C:\RoboLime\data\robolime-field.sqlite
GATEWAY_DB_PATH=
# Local HTTP API (npm run serve). LOOPBACK BY DEFAULT: blank means 127.0.0.1.
# 0.0.0.0 and :: are always refused. With GATEWAY_LAN_MODE off (default), only
# loopback addresses are accepted.
GATEWAY_HOST=
# LAN mode (decision D36): "on" or "off" (blank = off; case-insensitive; any
# other value refuses to start). `npm run serve -- --lan` also turns it on.
# When on, GATEWAY_HOST MUST be this computer's own private IPv4 address
# (10.x, 172.16-31.x or 192.168.x) currently assigned to its Wi-Fi/hotspot
# interface; anything else (public, link-local, IPv6, host name, unassigned)
# refuses to start - there is no fallback to another address. Requests must
# then use exactly http://<that address>:<port> (localhost is not accepted).
# Plain, unencrypted HTTP: use only on a trusted, password-protected field
# network, never a public network or the internet. Firewall: allow inbound TCP
# on the port for the Private profile and the local subnet only, and remove
# the rule after use; the gateway never changes firewall settings.
GATEWAY_LAN_MODE=
# Blank means 8780. Integer 1-65535.
GATEWAY_PORT=
# DEMO ONLY (decision D47). Blank or "off" = off (default). "on" accepts the
# fixed, predictable demo pairing code on a synthetic demo database over
# loopback; refused with a field database or LAN mode. Never set in the field.
GATEWAY_DEMO_PAIRING=
# Optional: folder produced by `npm run build:web` (apps/mobile/dist) to serve
# the web app at / on the same address as the API (decision D33). Blank = off.
# Use an absolute path; relative paths resolve from apps/gateway.
GATEWAY_WEB_DIR=
# MANUAL CONTROL (decision D57). Serial port of the USB LoRa bridge running
# "Robot Code/Final Code/finalcode_sprint1_gateway.ino" (e.g. COM5 on Windows,
# /dev/ttyUSB0 on a Pi). Blank = manual control off. `--serial-port` overrides
# it. Loopback mode only (refused with LAN mode).
GATEWAY_SERIAL_PORT=
# Blank means 115200 (the bridge sketch's Serial.begin rate).
GATEWAY_SERIAL_BAUD=
# ONLINE MANUAL CONTROL (decision D58): with GATEWAY_SERIAL_PORT set AND the
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY below, `npm run serve` relays
# commands from the Vercel site / Android app (anyone who claimed the robot)
# while this laptop has internet. The robot's source id as stored in the cloud;
# blank = the only robot in the gateway database.
GATEWAY_RELAY_ROBOT_ID=

# Hosted Supabase cloud mirror — read only by the cloud sync worker
# (src/cli/sync.ts, decision D35; not yet an npm script).
# Also read by `npm run cloud:claim-code` (online claim code, decision D52) and
# by `npm run serve` for online manual control (D58, only with GATEWAY_SERIAL_PORT). Gateway-only
# privileged credential: keep it on the gateway machine. Never commit it, paste
# it in chat, or ship it to the Expo app or any web bundle.
# SUPABASE_URL is the bare project origin, e.g. https://<project>.supabase.co
# (https required; plain http only for a loopback test target). A demo
# database refuses any non-loopback target.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Planned for later Phase 4 milestones (not read by any code yet) ----------
# Local session lifetime in days (code default: 90).
GATEWAY_SESSION_TTL_DAYS=
